# Copy to .env (never commit .env). See SETUP.md for where each value comes from.

# --- Supabase (web + worker) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Worker: Postgres connection string (Supabase "Session pooler" URI, IPv4-compatible)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- GitHub (web -> workflow_dispatch of backfill.yml to start a backfill run) ---
# Fine-grained personal access token for this repository only, permission "Actions: read and write".
GITHUB_DISPATCH_TOKEN=github_pat_xxx
GITHUB_REPO=L0nsett/omdomme-tracker

# --- Reddit (script app, read-only) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=omdomme-tracker/0.1 by your-reddit-username

# --- Web search (free tiers only, no credit card) ---
TAVILY_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=

# --- Local tests only ---
TEST_DATABASE_URL=postgresql://localhost:5432/omdomme_test
